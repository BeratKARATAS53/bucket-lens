{
	"name": "bucket-lens",
	"version": "0.2.0",
	"description": "Browse B2, Wasabi, S3, R2, Spaces, MinIO, and FTP on your own computer.",
	"main": "electron/main.mjs",
	"author": {
		"name": "D. Berat KARATAŞ",
		"email": "007berat.karatas@gmail.com"
	},
	"desktopName": "bucket-lens.desktop",
	"scripts": {
		"ng": "ng",
		"start": "concurrently -k -n api,web \"node server/index.mjs\" \"ng serve --host 0.0.0.0 --port 4205\"",
		"build": "ng build",
		"watch": "ng build --watch --configuration development",
		"lint": "eslint \"src/**/*.ts\" \"src/**/*.html\"",
		"test": "node --test server/*.test.mjs",
		"screenshots": "pnpm build && node scripts/capture-screenshots.mjs",
		"desktop": "pnpm build && electron .",
		"dist:linux": "pnpm build && electron-builder --linux deb AppImage --publish never",
		"dist:win": "pnpm build && electron-builder --win nsis --publish never"
	},
	"private": true,
	"packageManager": "pnpm@8.13.1",
	"dependencies": {
		"@angular/common": "^21.2.0",
		"@angular/compiler": "^21.2.0",
		"@angular/core": "^21.2.0",
		"@angular/forms": "^21.2.0",
		"@angular/platform-browser": "^21.2.0",
		"@angular/router": "^21.2.0",
		"@fontsource/figtree": "^5.3.0",
		"@fontsource/fredericka-the-great": "^5.3.0",
		"@napi-rs/keyring": "^2.1.1",
		"aws4fetch": "^1.0.20",
		"axios": "^1.12.2",
		"basic-ftp": "^6.2.3",
		"rxjs": "~7.8.0",
		"tslib": "^2.3.0"
	},
	"devDependencies": {
		"@angular-eslint/eslint-plugin": "^21.2.0",
		"@angular-eslint/eslint-plugin-template": "^21.2.0",
		"@angular-eslint/template-parser": "^21.2.0",
		"@angular/build": "^21.2.24",
		"@angular/cli": "^21.2.24",
		"@angular/compiler-cli": "^21.2.0",
		"@eslint/eslintrc": "^3.3.1",
		"@eslint/js": "^9.36.0",
		"@tailwindcss/postcss": "^4.3.3",
		"@typescript-eslint/eslint-plugin": "^8.46.0",
		"@typescript-eslint/parser": "^8.46.0",
		"concurrently": "^9.2.1",
		"electron": "^44.7.0",
		"electron-builder": "^26.15.3",
		"eslint": "^9.36.0",
		"eslint-config-prettier": "^10.1.8",
		"postcss": "^8.5.29",
		"playwright": "^1.58.2",
		"prettier": "^3.8.1",
		"tailwindcss": "^4.3.3",
		"typescript": "~5.9.2",
		"typescript-eslint": "^8.46.0"
	},
	"build": {
		"appId": "app.bucketlens",
		"productName": "Bucket Lens",
		"executableName": "bucket-lens",
		"npmRebuild": false,
		"directories": {
			"output": "release"
		},
		"files": [
			"electron/**/*",
			"server/**/*",
			"!server/**/*.test.mjs",
			"dist/bucket-lens/**/*",
			"package.json"
		],
		"asarUnpack": [
			"**/*.node"
		],
		"linux": {
			"icon": "build/icons",
			"category": "Utility",
			"syncDesktopName": true,
			"desktop": {
				"entry": {
					"StartupWMClass": "bucket-lens"
				}
			},
			"extraFiles": [
				{
					"from": "build/icons/256x256.png",
					"to": "icon.png"
				}
			],
			"target": [
				"deb",
				"AppImage"
			]
		},
		"deb": {
			"artifactName": "bucket-lens-linux-amd64.${ext}",
			"afterInstall": "build/linux/after-install.sh",
			"afterRemove": "build/linux/after-remove.sh"
		},
		"appImage": {
			"artifactName": "bucket-lens-linux-x64.${ext}"
		},
		"win": {
			"icon": "public/logo.png",
			"target": [
				"nsis"
			]
		},
		"nsis": {
			"oneClick": true,
			"perMachine": false,
			"createDesktopShortcut": true,
			"createStartMenuShortcut": true,
			"shortcutName": "Bucket Lens",
			"artifactName": "bucket-lens-windows-x64.${ext}"
		}
	}
}
